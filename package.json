{
  "name": "ourus",
  "version": "0.0.0",
  "description": "Editor-agnostic core for outliner editing of plain-text Markdown",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p . && tsc -p demo/cm6",
    "demo:build": "node demo/cm6/build.ts",
    "demo:serve": "node demo/cm6/build.ts --serve",
    "demo:smoke": "node demo/cm6/smoke.ts",
    "test:model": "node test/model/run.ts",
    "test:logseq": "node test/logseq/run.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/commonmark": "^0.27.10",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "commonmark": "^0.31.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
