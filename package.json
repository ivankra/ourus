{
  "name": "ourus",
  "version": "0.0.0",
  "description": "Editor-agnostic core for outliner editing of plain-text Markdown",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./extend": "./src/parser/extend.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts test/*/*.test.ts sxs/*/*.test.ts",
    "typecheck": "tsc -p . && tsc -p demo/cm6",
    "demo:build": "node demo/cm6/build.ts",
    "demo:serve": "node demo/cm6/build.ts --serve",
    "demo:smoke": "node demo/cm6/smoke.ts",
    "test:model": "node test/model/run.ts",
    "sxs": "node sxs/run.ts",
    "test:diff": "node test/differential.ts",
    "bench": "node test/bench.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/commonmark": "^0.27.10",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/showdown": "^2.0.6",
    "codemirror": "^6.0.2",
    "commonmark": "^0.31.2",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^18.0.14",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "obsidian-launcher": "^3.2.1",
    "playwright-core": "^1.64.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "showdown": "^2.1.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  }
}
